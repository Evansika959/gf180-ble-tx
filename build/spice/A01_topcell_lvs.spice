Xc3 TOP BOTTOM cap_mim_2f0_m5m6_noshield c_width=23.6u c_length=94.495u
.ends PLL_C2_UNIT

.subckt A01_topcell VDD VSS VDD_VCO VCTRL CP_IBIAS TAIL_BIAS VTUNE REF_1M CLK_8M UART_RX RST_N CFG[0] CFG[1] CFG[2] CFG[3] CFG[4] CFG[5] RF_OUT FINE_CODE[0] FINE_CODE[1] FINE_CODE[2] FINE_CODE[3] FINE_CODE[4] FINE_CODE[5] FINE_CODE[6] FINE_CODE[7] CODE_VALID AIR_BIT SYM_STROBE
Xtx VDD VSS CLK_8M RST_N UART_RX CODE_VALID AIR_BIT SYM_STROBE FINE_CODE[0] FINE_CODE[1] FINE_CODE[2] FINE_CODE[3] FINE_CODE[4] FINE_CODE[5] FINE_CODE[6] FINE_CODE[7] ble_tx_uart
Xdivider VDD VSS RST_N PRESCALED FB_1M MC CFG[0] CFG[1] CFG[2] CFG[3] CFG[4] CFG[5] ble_feedback_divider
Xprescaler VDD VSS CORE_CLK MC PRESCALED 32_33_Complete_Prescaler
Xvco VDD_VCO VDD VSS RF_OUT VTUNE TAIL_BIAS CORE_CLK Differential_VCO_ROUTED
Xpfd VDD VSS REF_1M FB_1M UPB DN Phase_Detector_FE
Xpump VDD VSS UPB DN CP_IBIAS VCTRL Charge_Pump_FE
Xres VCTRL LF_RZ VSS PLL_RZ
Xc1 VSS VCTRL PLL_C1
Xc2_0 VSS LF_RZ PLL_C2_UNIT
