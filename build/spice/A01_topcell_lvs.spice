* Macro-boundary LVS source with explicit RC filter devices.
.subckt ble_tx_uart VDD VSS clk rst_n uart_rx code_valid air_bit sym_strobe fine_code[0] fine_code[1] fine_code[2] fine_code[3] fine_code[4] fine_code[5] fine_code[6] fine_code[7]
.ends ble_tx_uart
.subckt ble_feedback_divider VDD VSS rst_n clk_prescaled clk_feedback modulus_33 cfg_divider[0] cfg_divider[1] cfg_divider[2] cfg_divider[3] cfg_divider[4] cfg_divider[5]
.ends ble_feedback_divider
.subckt 32_33_Complete_Prescaler VDD VSS CLK_IN MC CLK_OUT
.ends 32_33_Complete_Prescaler
.subckt Differential_VCO_ROUTED VDD VBUF VSS DOUBLE_OUT VTUNE TAIL_BIAS PRESCALER_CLK
.ends Differential_VCO_ROUTED
.subckt Phase_Detector_FE VDD VSS F_REF F_VCO UPb DN
.ends Phase_Detector_FE
.subckt Charge_Pump_FE VDD VSS UPb DN IBIAS OUT
.ends Charge_Pump_FE
.subckt PLL_RZ P N B
Xr P N B ppolyf_u r_width=0.8u r_length=88.055u
.ends PLL_RZ
.subckt PLL_C1 TOP BOTTOM
