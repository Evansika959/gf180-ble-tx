VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO ble_tx_uart
  CLASS BLOCK ;
  FOREIGN ble_tx_uart ;
  ORIGIN 0.000 0.000 ;
  SIZE 270.000 BY 300.000 ;
  PIN VDD
    DIRECTION INOUT ;
    USE POWER ;
    PORT
      LAYER Metal4 ;
        RECT 22.240 7.540 23.840 290.380 ;
    END
    PORT
      LAYER Metal4 ;
        RECT 175.840 7.540 177.440 290.380 ;
    END
    PORT
      LAYER Metal5 ;
        RECT 6.720 23.690 263.200 25.290 ;
    END
    PORT
      LAYER Metal5 ;
        RECT 6.720 176.870 263.200 178.470 ;
    END
  END VDD
  PIN VSS
