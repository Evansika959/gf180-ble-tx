    PORT
      LAYER Metal2 ;
        RECT 35.840 62.480 36.400 63.040 ;
    END
  END cfg_divider[2]
  PIN cfg_divider[3]
    DIRECTION INPUT ;
    USE SIGNAL ;
    ANTENNAGATEAREA 1.598000 ;
    PORT
      LAYER Metal3 ;
        RECT 51.280 40.320 51.840 40.880 ;
    END
  END cfg_divider[3]
  PIN cfg_divider[4]
    DIRECTION INPUT ;
    USE SIGNAL ;
    ANTENNAGATEAREA 1.931500 ;
    PORT
      LAYER Metal3 ;
        RECT 51.280 32.480 51.840 33.040 ;
    END
  END cfg_divider[4]
  PIN cfg_divider[5]
    DIRECTION INPUT ;
    USE SIGNAL ;
    ANTENNAGATEAREA 2.496000 ;
    PORT
      LAYER Metal3 ;
        RECT 0.000 34.720 0.560 35.280 ;
    END
  END cfg_divider[5]
  PIN clk_feedback
    DIRECTION OUTPUT ;
