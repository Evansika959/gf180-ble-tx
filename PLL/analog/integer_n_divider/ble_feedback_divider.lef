VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO ble_feedback_divider
  CLASS BLOCK ;
  FOREIGN ble_feedback_divider ;
  ORIGIN 0.000 0.000 ;
  SIZE 51.840 BY 63.040 ;
  PIN VDD
    DIRECTION INOUT ;
    USE POWER ;
    PORT
      LAYER Metal4 ;
        RECT 6.440 7.540 8.040 55.180 ;
    END
    PORT
      LAYER Metal4 ;
        RECT 31.440 7.540 33.040 55.180 ;
